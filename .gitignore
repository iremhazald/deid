# Environment files
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]

# Python packaging artifacts
*.egg-info/

# Test and coverage artifacts
.pytest_cache/
.coverage
coverage/
htmlcov/

# Node dependencies and build output
node_modules/
dist/

# Runtime output directories
outputs/
redacted_outputs/
evaluation/runs/

# Temporary and debug directories
.tmp/
.tmp-debug/
_tmp*/

# OS metadata
.DS_Store
Thumbs.db

# Model weights (downloaded at runtime)
*.onnx

# Document artifacts (privacy protection)
*.pdf
*.docx

# Private test suite (excluded from public repository)
# The private regression corpus contains data derived from legal documents.
# This exclusion allows developers to restore it locally for internal testing
# without risk of accidental commit. The tests below are synthetic
# and are the public exceptions, together with the email-boundary and placeholder tests.
apps/api/tests/*
!apps/api/tests/test_reidentification.py
!apps/api/tests/test_email_boundaries.py
!apps/api/tests/test_placeholder_identity.py
!apps/api/tests/test_prosecutor_clerk_roles.py
!apps/api/tests/test_legal_role_labels.py
!apps/api/tests/test_company_title.py
!apps/api/tests/test_ner_word_bounds.py
!apps/api/tests/test_court_running_header.py
!apps/api/tests/test_docx_export_metadata.py
!apps/api/tests/test_en_national_id_label.py
!apps/api/tests/test_residual_placeholders.py
