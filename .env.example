REDACTION_ALLOWED_ORIGIN=http://localhost:5173
REDACTION_JOB_TTL_SECONDS=86400
REDACTION_MAX_FILE_MB=25
REDACTION_OUTPUT_DIR=outputs
# Optional local workspace for saved works and the term dictionary.
# Default: ~/.deid
# DEID_WORKSPACE_DIR=
# REDACTION_WORKSPACE_DIR=

# Optional on-device NER for LOCAL_CONTEXT (the normal product scan).
# RULES_ONLY never loads these models. Runtime inference uses locally cached
# files by default.
# DEID_TR_NER_MODEL=akdeniz27/bert-base-turkish-cased-ner
# DEID_TR_NER_BACKEND=onnx
# DEID_TR_NER_ONNX_VARIANT=fp32
# DEID_EN_NER_MODEL=en_core_web_sm
# DEID_NER_LOCAL_FILES_ONLY=true
# DEID_NER_MAX_CHARS_PER_CHUNK=1200
# DEID_NER_CHUNK_OVERLAP_CHARS=80
# Development-only local NER counters / bounded entity samples. Off by default.
# DEID_NER_DEBUG=false

# Optional landing-page project links. Unconfigured links remain non-clickable.
VITE_GITHUB_URL=
VITE_DOCUMENTATION_URL=
VITE_PRIVACY_URL=
VITE_LICENSE_URL=
